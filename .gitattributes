# Enforce LF line endings for text files across Windows / macOS / Linux
# clones. Consumers clone this repo into their own project's `asdd/` and
# then load its Markdown into agent context — CRLF would show up as `\r\n`
# artifacts in prompts.

*                       text=auto eol=lf

# Explicit for the content types we ship
*.md                    text eol=lf
*.yml                   text eol=lf
*.yaml                  text eol=lf
*.example               text eol=lf
*.sh                    text eol=lf
LICENSE                 text eol=lf

# GitHub linguist — treat all Markdown as documentation (not "detected
# language") so the repo's language stats stay clean.
*.md                    linguist-documentation
templates/*.md          linguist-documentation
templates/*.example     linguist-documentation
skills/*.md             linguist-documentation
prompts/*.md            linguist-documentation
